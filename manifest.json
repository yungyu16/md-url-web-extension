{
  "manifest_version": 3,
  "name": "Markdown URL",
  "version": "0.0.1",
  "description": "自动生成当前页面的md url并添加到粘贴板",
  "action": {
    "default_icon": {
      "32": "icon-32.png"
    }
  },
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "activeTab"
  ],
  "devtools_page": "src/pages/devtools/index.html"
}
